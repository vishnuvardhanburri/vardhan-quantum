# P9 Dockerfile — Reproducible build for containerized adversarial validation
#
# Builds all P8-frozen crates as a test image. Not intended for production
# deployment; this image exists for P9.1 reproducible validation only.
#
# Pin: rust:1.98.1-slim-bookworm (matches local Rust 1.98.1)
# Provenance: built from vP8-frozen @ 6b43fd751c9df3539c4c9f3f104b3272c57a84bc

FROM rust:1.98.1-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies (pinned versions)
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    build-essential \
    clang \
    cmake \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (UID 10001, same as P3.6)
RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 10001 --ingroup appgroup appuser

# Write provenance marker (proves build-from-source)
RUN echo "6b43fd751c9df3539c4c9f3f104b3272c57a84bc" > /v8_provenance.txt

# Copy workspace manifests first (leverages Docker layer cache)
COPY --chown=appuser:appgroup Cargo.toml .
COPY --chown=appuser:appgroup Cargo.lock .
COPY --chown=appuser:appgroup backend/ ./backend/

USER appuser:appgroup

# Build backend binaries (excluding pq_verify — pre-existing P7.3 compile issue)
RUN cargo build --release \
    -p core_crypto \
    -p proxy_engine \
    -p ledger_sync \
    -p ledger_persistence \
    -p quantum_network \
    -p quantum_node \
    -p pq_shield \
    -p audit_ledger \
    -p auth_service \
    -p ha_cluster \
    -p mock_upstream \
    -p verifier \
    -p saas_metering \
    -p enterprise_tenant \
    -p load_tester \
    2>&1

# Build test binaries (P8 + P7.3 regression suites)
RUN cargo test --release -p ha_cluster --no-run 2>&1

# Write provenance file for runtime stage
RUN echo "6b43fd751c9df3539c4c9f3f104b3272c57a84bc" > /v8_commit.txt

# Stage 2: Minimal runtime with non-root user
FROM gcr.io/distroless/cc-debian12:nonroot

WORKDIR /app

# Copy provenance
COPY --from=builder --chown=nonroot:nonroot /v8_commit.txt /app/V8_COMMIT.txt

# Copy all built binaries
COPY --from=builder --chown=nonroot:nonroot /build/target/release/pq_shield /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/quantum_node /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/verifier /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/mock_upstream /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/load_tester /app/

# Copy test binaries (P8 suites)
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_segment_retention-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_regression_p8003-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_regression_p8004-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_byzantine-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_transport-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_partition-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_crash_corruption-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_key_compromise-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_resource_exhaustion-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_p8_soak-* /app/

# Copy test binaries (P7.3 regression suites)
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_l3_1_hardening-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_l3_2_checkpoints-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_l3_replication-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_l3_validation-* /app/
COPY --from=builder --chown=nonroot:nonroot /build/target/release/deps/raft_l3_failure-* /app/

# Copy the test runner scripts
COPY --chown=nonroot:nonroot p9/run_tests.sh /app/run_tests.sh
COPY --chown=nonroot:nonroot p9/run_behavioral.sh /app/run_behavioral.sh
RUN chmod +x /app/run_tests.sh /app/run_behavioral.sh

USER nonroot

ENTRYPOINT ["/app/run_behavioral.sh"]
