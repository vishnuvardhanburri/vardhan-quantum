# Vardhan Quantum Frontend — Environment Configuration
# ===================================================
# Copy this file to .env.local and adjust values as needed.

# pq_shield admin API backend (reverse proxy target for /api/v1/* calls)
# In Docker Compose, use http://pq-shield:8081
# In local dev, use http://127.0.0.1:8081
VARDHAN_BACKEND_URL=http://127.0.0.1:8081

# pq_shield proxy ingress URL (used for status display / linking)
VARDHAN_INGRESS_URL=http://127.0.0.1:8080

# Admin Bearer token — must match pq_shield's VARDHAN_ADMIN_TOKEN
# This token is used server-side by the Express proxy when forwarding
# /api/v1/* requests to pq_shield. It never reaches the browser.
ADMIN_TOKEN=RETRACTED-STAGING-TOKEN

# Frontend port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=production
