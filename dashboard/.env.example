# Vardhan Quantum Dashboard — Environment Configuration
# Copy to .env.local and adjust for your deployment.

# Backend admin API base URL
# The pq_shield admin server (default: http://localhost:8081)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# Admin token for the backend API (VARDHAN_ADMIN_TOKEN on the backend side)
# Leave empty to enter the token via the login screen at runtime.
NEXT_PUBLIC_ADMIN_TOKEN=

# Backend admin port (used by the proxy route handler to forward requests)
# Only needed if different from NEXT_PUBLIC_API_BASE_URL
# ADMIN_TOKEN=
