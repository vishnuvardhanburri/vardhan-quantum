# Vardhan Quantum Dashboard — Environment Configuration
# Copy to .env.local and adjust for your deployment.

# ── Server-side only (NOT exposed to browser) ──────────────────────────────
# The URL of the pq_shield admin API.  This is read ONLY by the Next.js route
# handler proxy (dashboard/app/api/admin/[...path]/route.js) and is never
# inlined into the browser bundle by Next.js.
# Do NOT prefix with NEXT_PUBLIC_* — that would expose it to the browser.
VARDHAN_BACKEND_URL=http://pq-shield:8081

# The admin token that the proxy uses to authenticate backend API calls.
# Set this to match the VARDHAN_ADMIN_TOKEN configured on the pq_shield service.
# This env var is server-only; it is NEVER exposed to the browser.
# The token that browser clients send is the one they enter at the login
# screen — stored in memory only.
ADMIN_TOKEN=changeme

# ── Next.js settings ────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
